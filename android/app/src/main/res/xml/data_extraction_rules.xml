<?xml version="1.0" encoding="utf-8"?>
<!-- 日记内容不进系统云备份与设备迁移：跨设备只走日迹自己的端到端加密同步。 -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="." />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="." />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
