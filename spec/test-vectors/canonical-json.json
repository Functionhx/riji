{
  "description": "规范 JSON：对象键按 UTF-16 码元排序、无空白、数组保序、字符串按 JSON 标准转义（非 ASCII 原样输出）。",
  "cases": [
    {
      "input": {
        "b": 1,
        "a": [
          3,
          2,
          {
            "d": null,
            "c": true
          }
        ]
      },
      "output": "{\"a\":[3,2,{\"c\":true,\"d\":null}],\"b\":1}"
    },
    {
      "input": {
        "标题": "电路 18 讲",
        "text": "引号\"与\\反斜杠\n换行"
      },
      "output": "{\"text\":\"引号\\\"与\\\\反斜杠\\n换行\",\"标题\":\"电路 18 讲\"}"
    },
    {
      "input": {
        "n": -0.5,
        "big": 1759889000000,
        "z": 0
      },
      "output": "{\"big\":1759889000000,\"n\":-0.5,\"z\":0}"
    },
    {
      "input": {
        "B": 1,
        "a": 2,
        "_": 3
      },
      "output": "{\"B\":1,\"_\":3,\"a\":2}"
    }
  ]
}
